# Database
DATABASE_URL="postgresql://user:password@localhost:5432/swfl_cleaning_estimator"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-run-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google Maps (optional - for address autocomplete and distance)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Email (optional - for sending proposals)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="SWFL Cleaning Estimator <noreply@yourcompany.com>"

# Company branding
NEXT_PUBLIC_COMPANY_NAME="SWFL Cleaning Pro"
NEXT_PUBLIC_COMPANY_PHONE="(239) 555-0100"
NEXT_PUBLIC_COMPANY_EMAIL="info@swflcleaning.com"
NEXT_PUBLIC_COMPANY_WEBSITE="https://swflcleaning.com"
